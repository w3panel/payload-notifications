{
  "name": "@wtree/payload-notifications",
  "version": "0.3.0",
  "description": "Production-ready notifications plugin for Payload CMS",
  "keywords": [
    "notifications",
    "payload",
    "payload-plugin",
    "payloadcms",
    "alerts",
    "messaging"
  ],
  "homepage": "https://github.com/w3panel/payload-notifications#readme",
  "bugs": {
    "url": "https://github.com/w3panel/payload-notifications/issues"
  },
  "license": "MIT",
  "author": "wtree",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/w3panel/payload-notifications.git"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "COMPATIBILITY.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser.mjs",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/browser.mjs",
      "require": "./dist/browser.js"
    },
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "import": "./dist/admin/index.mjs",
      "default": "./dist/admin/index.mjs"
    },
    "./styles.css": "./dist/styles.css",
    "./dist/styles.css": "./dist/styles.css"
  },
  "browser": {
    "./dist/index.mjs": "./dist/browser.mjs",
    "./dist/index.js": "./dist/browser.js"
  },
  "sideEffects": [
    "*.css",
    "dist/styles.css"
  ],
  "scripts": {
    "build": "bun run clean && rolldown -c && tsc --declaration --emitDeclarationOnly --outDir dist",
    "clean": "rm -rf dist",
    "dev": "rolldown -c --watch",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "lint": "oxlint src tests",
    "lint:fix": "oxlint src tests --fix",
    "format": "oxfmt \"**/*.{js,mjs,cjs,ts,tsx,mts,cts}\"",
    "format:check": "oxfmt --check \"**/*.{js,mjs,cjs,ts,tsx,mts,cts}\"",
    "check": "bun run lint && bun run format:check && bun run test",
    "prepare": "husky",
    "prepublishOnly": "bun run test && bun run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "@types/node": "^25.3.5",
    "@types/react": "19",
    "@types/react-dom": "19",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.51.0",
    "payload": "4.0.0-beta.4",
    "prettier": "^3.8.1",
    "react": "19",
    "react-dom": "19",
    "rolldown": "^1.0.0-rc.7",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "payload": ">=4.0.0-beta.4 <5",
    "react": ">=18 <20",
    "@payloadcms/ui": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@payloadcms/ui": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.22.1"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,mts,cts}": [
      "oxfmt",
      "oxlint --fix"
    ]
  }
}
