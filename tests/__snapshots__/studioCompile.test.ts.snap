// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`compileDesign produces Gmail/Outlook-safe markup (snapshot) 1`] = `"<!DOCTYPE html><html lang="en" xmlns="http://www.w3.org/1999/xhtml"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="x-apple-disable-message-reformatting"><meta name="color-scheme" content="light dark"><meta name="supported-color-schemes" content="light dark"><style>@media only screen and (max-width:620px){.pn-container{width:100%!important}.pn-col{max-width:100%!important;display:block!important}}:root{color-scheme:light dark;supported-color-schemes:light dark}</style><!--[if mso]><style>table,td,h1,h2,h3,p,a{font-family:Arial,sans-serif!important}</style><![endif]--></head><body style="margin:0;padding:0;background-color:#f4f4f5;-webkit-text-size-adjust:100%"><!-- payload-notifications:visual --><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f4f4f5" style="background-color:#f4f4f5"><tr><td align="center" style="padding:24px 12px"><!--[if mso]><table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0"><tr><td><![endif]--><table role="presentation" class="pn-container" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#ffffff" style="width:100%;max-width:600px;background-color:#ffffff;border-collapse:collapse"><tr><td style="padding:12px 24px"><h1 style="margin:0;font-family:-apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;font-size:28px;line-height:1.25;font-weight:700;color:#18181b;text-align:left">Order <strong>{{ payload.orderId }}</strong> is confirmed</h1></td></tr><tr><td style="padding:8px 24px"><p style="margin:0 0 0;font-family:-apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;font-size:16px;line-height:1.5;color:#18181b;text-align:left">Hi {{ recipient.name | default "there" }},</p><p style="margin:12px 0 0;font-family:-apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;font-size:16px;line-height:1.5;color:#18181b;text-align:left">Thanks for your <em>order</em>.</p></td></tr>{{#if payload.items}}{{#each payload.items}}<tr><td style="padding:8px 24px"><p style="margin:0 0 0;font-family:-apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;font-size:16px;line-height:1.5;color:#18181b;text-align:left">{{ name }} × {{ qty }}</p></td></tr>{{/each}}{{else}}<tr><td style="padding:8px 24px"><p style="margin:0;font-family:-apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;font-size:14px;line-height:1.5;color:#71717a">No items</p></td></tr>{{/if}}{{#if payload.trackingNumber}}<tr><td style="padding:8px 24px"><p style="margin:0 0 0;font-family:-apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;font-size:16px;line-height:1.5;color:#18181b;text-align:left">Tracking: {{ payload.trackingNumber }}</p></td></tr>{{else}}<tr><td style="padding:8px 24px"><p style="margin:0 0 0;font-family:-apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;font-size:16px;line-height:1.5;color:#18181b;text-align:left">Tracking follows soon.</p></td></tr>{{/if}}<tr><td style="padding:0 24px;font-size:0;text-align:left"><!--[if mso]><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td width="276" valign="top"><![endif]--><div class="pn-col" style="display:inline-block;width:100%;max-width:276px;vertical-align:top;font-size:16px"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse"><tr><td align="left" style="padding:8px 24px"><img src="https://cdn.example.com/p.png" alt="Product" width="228" style="display:block;width:100%;max-width:228px;height:auto;border:0;outline:none;text-decoration:none"></td></tr></table></div><!--[if mso]></td><td width="276" valign="top"><![endif]--><div class="pn-col" style="display:inline-block;width:100%;max-width:276px;vertical-align:top;font-size:16px"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse"><tr><td style="padding:12px 24px"><table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center" style="margin:0 auto"><tr><td align="center" bgcolor="#2563eb" style="border-radius:6px;background-color:#2563eb"><a href="{{ payload.url }}" target="_blank" rel="noopener" style="display:inline-block;padding:12px 24px;font-family:-apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;font-size:16px;font-weight:600;line-height:1.25;color:#ffffff;text-decoration:none;border-radius:6px">Track order</a></td></tr></table></td></tr></table></div><!--[if mso]></td></tr></table><![endif]--></td></tr><tr><td style="padding:12px 24px"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse"><tr><td style="border-top:1px solid #e4e4e7;font-size:0;line-height:0">&nbsp;</td></tr></table></td></tr><tr><td style="padding:8px 24px"><ul style="margin:0;padding:0 0 0 24px;font-family:-apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;font-size:16px;line-height:1.5;color:#18181b"><li style="margin:0 0 4px">Fast delivery</li><li style="margin:0 0 4px"><a href="https://example.com/returns" target="_blank" rel="noopener" style="color:#2563eb;text-decoration:underline">Returns</a></li></ul></td></tr><tr><td style="padding:8px 24px"><p style="margin:0;font-family:-apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;font-size:14px;line-height:1.5;color:#18181b;text-align:center"><a href="https://instagram.com/acme" target="_blank" rel="noopener" style="color:#2563eb;text-decoration:underline">Instagram</a></p></td></tr><tr><td style="padding:16px 24px"><p style="margin:0;font-family:-apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;font-size:12px;line-height:1.5;color:#71717a;text-align:center">Acme Inc.{{#if unsubscribeUrl}}<br><a href="{{ unsubscribeUrl }}" target="_blank" rel="noopener" style="color:#71717a;text-decoration:underline">Unsubscribe</a>{{/if}}</p></td></tr></table><!--[if mso]></td></tr></table><![endif]--></td></tr></table></body></html>"`;

exports[`compileDesign produces Gmail/Outlook-safe markup (snapshot) 2`] = `
"Order {{ payload.orderId }} is confirmed

Hi {{ recipient.name | default "there" }},

Thanks for your order.

{{#if payload.items}}{{#each payload.items}}{{ name }} × {{ qty }}
{{/each}}{{else}}No items{{/if}}

{{#if payload.trackingNumber}}Tracking: {{ payload.trackingNumber }}{{else}}Tracking follows soon.{{/if}}

Track order: {{ payload.url }}

----------

- Fast delivery
- Returns (https://example.com/returns)

Instagram: https://instagram.com/acme

Acme Inc.{{#if unsubscribeUrl}}
Unsubscribe: {{ unsubscribeUrl }}{{/if}}"
`;
